# Copy to ~/.config/routeros-acme-renew/<router>.env and run with:
#   op run --env-file ~/.config/routeros-acme-renew/<router>.env -- routeros-acme-renew
# Values starting with op:// are resolved by 1Password at run time; nothing secret is stored here.

ROUTER_HOST=router.example.com
# Optional: connect here instead of ROUTER_HOST (an IP or a name that resolves from this machine).
# ROUTER_HOST stays the certificate name. Trust this address in ~/.ssh/known_hosts first.
# ROUTER_ADDRESS=192.0.2.1
ROUTER_SSH_USER=acme
ACME_EMAIL=you@example.com
# Which SSH key to use. A public key file picks that key from your ssh-agent (needed when the agent holds
# several keys, because RouterOS hangs up after the first one it rejects); a private key file is used directly.
# ROUTER_SSH_KEY=~/.config/routeros-acme-renew/router.pub

AWS_ACCESS_KEY_ID=op://Private/route53-acme/access key id
AWS_SECRET_ACCESS_KEY=op://Private/route53-acme/secret access key
AWS_REGION=us-east-1
# Optional: skips the zone lookup (the IAM policy can then drop ListHostedZonesByName).
# AWS_HOSTED_ZONE_ID=Z0000000000000
