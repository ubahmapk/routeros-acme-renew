# Copy to ~/.config/routeros-acme-renew/<router>.env and run with:
#   op run --env-file ~/.config/routeros-acme-renew/<router>.env -- routeros_acme_renew.py
# Values starting with op:// are resolved by 1Password at run time; nothing secret is stored here.

ROUTER_HOST=router.example.com
ROUTER_SSH_USER=acme
ACME_EMAIL=you@example.com

AWS_ACCESS_KEY_ID=op://Private/route53-acme/access key id
AWS_SECRET_ACCESS_KEY=op://Private/route53-acme/secret access key
AWS_REGION=us-east-1
# Optional: skips the zone lookup (the IAM policy can then drop ListHostedZonesByName).
# AWS_HOSTED_ZONE_ID=Z0000000000000

# Optional: use specific resolvers for lego's DNS propagation checks.
# LEGO_DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53
